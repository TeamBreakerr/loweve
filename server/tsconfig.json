{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "mocha"
    ],
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "index.ts"
  ]
}
