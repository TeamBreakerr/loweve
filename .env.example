# 复制为 .env 后填写。.env 已被 .gitignore，不会进版本库。

# ── 端口 & 数据 ──
LOWEVE_PORT=18083
LOWEVE_DATA_DIR=./data            # 数据卷（SQLite 库 + 海报缓存）

# ── 两位用户的初始名（仅首次启动写入 users 表）──
USER_A_NAME=Alice
USER_B_NAME=Bob

# ── TMDB（必填，用于检索影视元数据）──
# 申请：https://www.themoviedb.org/settings/api
# 有 v4 Bearer token 优先填 TOKEN；否则填 v3 hex API key（二选一即可）
TMDB_API_TOKEN=
TMDB_API_KEY=

# ── Bangumi（可选，番剧评分用的 User-Agent；建议换成你自己的标识）──
BANGUMI_USER_AGENT=loweve/1.0

# ── IGDB / Twitch（游戏全平台目录）──
# Twitch Developer Console 创建 Confidential 应用后填写。Client Secret 只放服务端，切勿提交。
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── Steam（无需配置）──
# Steam 版本的国区人民币价格及公开评测使用 Steam 商店公开接口，无需 API Key。

# ── LLM（可选，影视与游戏 AI 推荐；任意 OpenAI 兼容端点）──
# 三项都填才启用推荐，留空则推荐关闭。LLM_BASE_URL 形如 https://your-host/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 推理深度（可选）：low / medium / high 等，端点支持 reasoning_effort 时才有用；留空用模型默认
LLM_REASONING_EFFORT=

# ── 语音转写（可选，一起看过「点评室」的讨论录音）──
# asr-app 服务地址（POST /api/jobs 上传、带说话人分离）。留空则只保存录音、不转写不生成点评。
# 生成点评还需要上面的 LLM 三项。录音原件存 ${LOWEVE_DATA_DIR}/recordings/，永久保留。
ASR_BASE_URL=

# ── 时区 ──
TZ=Asia/Shanghai
